# Copie ce fichier en .env.local et remplis-le. .env.local n'est JAMAIS envoyé sur GitHub.
# Sur Vercel : ces valeurs se règlent dans Settings > Environment Variables.

# Base de données Neon. Injectée automatiquement par Vercel quand tu connectes Neon.
# En local : `vercel env pull .env.local` la récupère pour toi.
DATABASE_URL=

# Clé secrète qui signe les sessions (32 caractères minimum). Génère-la avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=
